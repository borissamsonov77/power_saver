# Site URL (required for canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (optional in development)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Amazon Associates tag (fill in after registration)
# Register at: https://affiliate-program.amazon.com
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# Rozetka Partner ID (fill in after registration)
# Register at: https://partner.rozetka.ua
NEXT_PUBLIC_ROZETKA_PARTNER_ID=
